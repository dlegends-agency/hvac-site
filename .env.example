# Supabase (publishable key is safe for the browser; access is enforced by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Production origin, used for canonical URLs and Open Graph metadata
VITE_SITE_URL=https://www.example.com

# Contact details. Leave blank until real; the header call button stays hidden without a phone number.
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_CONTACT_ADDRESS=



# Legal pages (optional)
VITE_LEGAL_ENTITY=
VITE_LEGAL_GOVERNING_STATE=

# CAPTCHA (optional): the public Cloudflare Turnstile site key. Leave empty to show no CAPTCHA. The secret key is a Cloudflare Pages
# secret named TURNSTILE_SECRET_KEY (never put it here).
VITE_TURNSTILE_SITE_KEY=
