# Supabase (publishable key is safe for the browser; access is enforced by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production origin, used for canonical URLs and Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact details. Leave blank until real; the header call button stays hidden without a phone number.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Lead delivery (server-side only, never exposed to the browser)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Set to true once LEAD_WEBHOOK_URL is working, to hide the "development mode" notice
NEXT_PUBLIC_LEAD_BACKEND_ENABLED=false
