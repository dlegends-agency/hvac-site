{
  "name": "hvac-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "discover": "node scripts/discovery-agent/index.mjs",
    "discover:test": "node scripts/discovery-agent/test.mjs",
    "test:stripe": "node scripts/test-stripe.mjs",
    "test:google": "node scripts/test-google.mjs",
    "test:notify": "node --import ./scripts/ts-resolve.mjs scripts/test-notify.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^6.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.62.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "type": "module"
}
